# TurnKey — environment variables

# Frontend (Netlify) — injected into config.js at build time
TURNKEY_BACKEND_URL=https://your-backend.onrender.com

# Frontend Supabase client (index.html talks to Supabase directly for
# customers/jobs/invoices/auth). The anon key is safe to expose client-side —
# access is enforced by RLS policies, not by keeping this secret.
TURNKEY_SUPABASE_URL=https://your-project.supabase.co
TURNKEY_SUPABASE_ANON_KEY=your-anon-public-key

# Backend (Render/Railway) — see backend/.env.example
# SYNC_KEY=your-long-random-secret
# STORAGE=file
# STORAGE=supabase + SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
