# TurnKey — environment variables

# Frontend (Netlify) — injected into config.js at build time
TURNKEY_BACKEND_URL=https://your-backend.onrender.com

# Frontend Supabase client (index.html talks to Supabase directly for
# customers/jobs/invoices/auth). The anon key is safe to expose client-side —
# access is enforced by RLS policies, not by keeping this secret.
TURNKEY_SUPABASE_URL=https://your-project.supabase.co
TURNKEY_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps (Static Maps + Geocoding + Places APIs, all under one key) —
# powers satellite view and address search on booking.html and in the CRM's
# quote map editor. Safe to expose client-side as long as it's restricted by
# HTTP referrer in Google Cloud Console (to your Netlify domain). OPTIONAL —
# if unset, the app falls back to a free OpenStreetMap view automatically —
# but see scripts/generate-config.js: this is the one var where "unset in
# THIS build" deliberately does not mean "erase it from the deployed site",
# so don't remove it from Netlify env vars expecting that to disable maps;
# it'll just keep whatever key the last build that had it set wrote.
TURNKEY_MAPS_KEY=your-google-maps-api-key

# OneSignal App ID (Web Push) — safe to expose client-side, it's only used
# to initialize OneSignal's SDK in the browser. Get it from your OneSignal
# dashboard → Settings → Keys & IDs, after creating a Web Push app there.
# OPTIONAL — if unset, push notifications stay off (same "don't erase on an
# unset build" carry-forward treatment as TURNKEY_MAPS_KEY above). The
# matching SECRET key (ONESIGNAL_API_KEY) is a BACKEND-only env var — see
# backend/.env.example — never put it here.
TURNKEY_ONESIGNAL_APP_ID=your-onesignal-app-id

# Backend (Render/Railway) — see backend/.env.example
# SYNC_KEY=your-long-random-secret
# OAUTH_STATE_SECRET=your-long-random-secret (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
# ONESIGNAL_APP_ID=same value as TURNKEY_ONESIGNAL_APP_ID above
# ONESIGNAL_API_KEY=your-onesignal-rest-api-key (SECRET — OneSignal dashboard → Settings → Keys & IDs)
# AUTOMATION_CRON_KEY=your-long-random-secret (gates POST /api/automations/run-due)
# STORAGE=file
# STORAGE=supabase + SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
